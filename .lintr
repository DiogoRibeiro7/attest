linters: linters_with_defaults(
    line_length_linter = line_length_linter(100),
    # cli and glue interpolate variables inside strings, which
    # object_usage_linter cannot see; it reports every such variable as unused.
    object_usage_linter = NULL,
    indentation_linter = NULL
  )
encoding: "UTF-8"
exclusions: list("tests")
